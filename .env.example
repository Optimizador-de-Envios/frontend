# URL base del servicio de autenticación (user-service)
# Local: http://localhost:8081
# Docker Compose o red interna: ajustá según el nombre real del servicio
VITE_AUTH_API_BASE=http://localhost:8081

# URL base del backend de órdenes (shipment-service)
# Local: http://localhost:8080
# Docker Compose: http://backend:8080
VITE_ORDER_API_BASE=http://localhost:8080

# API key de OpenRouteService
# Obtené la tuya en: https://openrouteservice.org/dev/#/signup
VITE_OPENROUTESERVICE_API_KEY=your_api_key_here
