# Copy this file to ".env.local" and fill in your API key.
# Never commit your actual key. Add .env.local to .gitignore if not already present.

# OpenRouteService API key for development only
VITE_OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Example: VITE_OPENROUTESERVICE_API_KEY=abcd1234
